{
  "Database": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=twitchtools;Username=postgres;Password=postgres"
  },
  "Keycloak": {
    "Authority": "https://keycloak.example.com/realms/twitch-tools",
    "MetadataAddress": "",
    "ClientId": "twitch-tools-web",
    "ClientSecret": "replace-me",
    "CallbackPath": "/signin-oidc",
    "RequireHttpsMetadata": true
  },
  "Twitch": {
    "BaseUrl": "https://api.twitch.tv",
    "OAuthBaseUrl": "https://id.twitch.tv",
    "DefaultClientId": "",
    "OAuthClientSecret": "",
    "OAuthRedirectUri": "http://localhost:8080/my-tools/connect/twitch/callback",
    "OAuthScopes": "moderator:read:chatters moderator:read:followers user:read:chat user:write:chat user:bot channel:bot channel:read:subscriptions",
    "EventSubCallbackUrl": "",
    "EventSubSecret": "",
    "DefaultBotUserId": ""
  },
  "YouTube": {
    "BaseUrl": "https://www.googleapis.com/youtube/v3",
    "OAuthBaseUrl": "https://accounts.google.com/o/oauth2/v2/auth",
    "TokenUri": "https://oauth2.googleapis.com/token",
    "TokenInfoUri": "https://oauth2.googleapis.com/tokeninfo",
    "DefaultClientId": "",
    "OAuthClientSecret": "",
    "OAuthRedirectUri": "http://localhost:8080/my-tools/connect/youtube/callback",
    "OAuthScopes": "https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl",
    "NotLivePollIntervalSeconds": 60,
    "MinChatPollIntervalSeconds": 10
  },
  "BlueSky": {
    "ServiceUrl": "https://bsky.social",
    "LiveProfilePrefix": "LIVE: "
  },
  "Discord": {
    "BaseUrl": "https://discord.com/api/v10",
    "BotToken": "",
    "BotClientId": "",
      "InvitePermissions": "8589935616",
      "InviteScopes": "bot"
  },
  "Encryption": {
    "Salt": "set-via-environment"
  },
  "FeatureFlags": {
    "DisableExternalPosting": false,
    "EnableOidcDebug": false,
    "EnableEventSubIngressLogging": false,
    "EnableEventSubPayloadLogging": false,
    "EventSubPayloadRetentionDays": 14
  },
  "Site": {
    "SupportContactEmail": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

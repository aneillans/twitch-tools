ENCRYPTION_SALT=replace-with-long-random-value
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=replace-with-long-random-value
DISCORD_BOT_CLIENT_ID=
FEATURE_DISABLE_EXTERNAL_POSTING=false
FEATURE_ENABLE_EVENTSUB_PAYLOAD_LOGGING=false
FEATURE_EVENTSUB_PAYLOAD_RETENTION_DAYS=14
SITE_SUPPORT_CONTACT_EMAIL=
# Defaults to the local otel-collector service in docker-compose.yml; override to point at
# whatever OTel collector / OpenSearch Data Prepper pipeline is already running elsewhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
